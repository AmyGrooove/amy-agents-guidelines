{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "runtime/dist",
    "paths": {
      "@app/*": [
        "src/app/*/index.ts",
        "src/app/*.ts"
      ],
      "@entities/*": [
        "src/entities/*/index.ts",
        "src/entities/*.ts"
      ],
      "@modules/*": [
        "src/modules/*/index.ts",
        "src/modules/*.ts"
      ],
      "@shared/*": [
        "src/shared/*/index.ts",
        "src/shared/*.ts"
      ]
    },
    "rootDir": "src",
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "src/**/*.ts"
  ]
}
